@model DeChimex.Host.Models.Admin.MarketingBroadcastFormViewModel
@{
    Layout = "_AdminLayout";
}
<div class="card">
    <div class="card-head">
        <div>
            <h3 style="font-size:16px;font-weight:800">Compose marketing broadcast</h3>
            <p class="text-muted" style="font-size:13px;margin-top:2px">
                Goes to <b>@ViewBag.EligibleRecipients</b> subscribed, registered customer(s) once you send it.
                Saving creates a draft - nothing is emailed until you press Send on the next screen.
            </p>
        </div>
    </div>
    <div class="card-body">
        <form method="post" asp-action="Compose" id="composeForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

            <div class="mb-3">
                <label class="label" asp-for="Subject">Subject <span class="req">*</span></label>
                <input class="input" asp-for="Subject" maxlength="200" placeholder="e.g. 20% off all branded mugs this month" />
                <span asp-validation-for="Subject" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label class="label" asp-for="HtmlContent">Email content (HTML) <span class="req">*</span></label>
                <textarea class="input" asp-for="HtmlContent" rows="12" style="font-family:ui-monospace,monospace;font-size:13px"
                          placeholder="<h2>Big month for your brand 💜</h2>&#10;<p>Enjoy 20% off ...</p>&#10;<p><a href='https://dechimexprinthub.com/products'>Shop now</a></p>"></textarea>
                <span asp-validation-for="HtmlContent" class="field-error"></span>
                <div class="text-muted" style="font-size:12px;margin-top:4px">
                    Simple HTML tags (headings, paragraphs, links, images, inline styles). Scripts, iframes and event
                    handlers are stripped automatically. An unsubscribe link is added to every email automatically.
                </div>
            </div>

            <div class="flex items-center gap-2" style="margin-top:18px">
                <button type="submit" class="btn btn-primary">Save draft</button>
                <button type="button" class="btn btn-outline" id="previewBtn">Live preview</button>
                <a class="btn btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

<div id="previewCard" class="card" style="margin-top:16px;display:none">
    <div class="card-head"><h3 style="font-size:14px;font-weight:800">Preview (approximation - the real email is branded and includes unsubscribe)</h3></div>
    <div class="card-body">
        <iframe id="previewFrame" style="width:100%;height:420px;border:1px solid var(--n-200);border-radius:10px;background:var(--canvas)"></iframe>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('previewBtn').addEventListener('click', function () {
            var subject = document.getElementById('@Html.IdFor(m => m.Subject)').value || '(no subject)';
            var body = document.getElementById('@Html.IdFor(m => m.HtmlContent)').value || '<p>(no content)</p>';
            var doc = '<!DOCTYPE html><html><head><meta charset="utf-8"></head>'
                + '<body style="margin:0;background:#F7F6F2;font-family:Inter,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#475569">'
                + '<div style="max-width:600px;margin:0 auto;padding:24px 12px">'
                + '<div style="background:#fff;border:1px solid #E7E4DC;border-radius:18px;overflow:hidden">'
                + '<div style="padding:18px 24px 16px;border-bottom:1px solid #E7E4DC">'
                + '<span style="display:inline-block;width:40px;height:40px;border-radius:11px;background:#312E81;text-align:center;vertical-align:middle">'
                + '<img src="/img/logo.png" width="34" height="34" alt="" style="width:34px;height:34px;margin:3px;border-radius:8px;background:#fff;display:block">'
                + '</span>'
                + '<span style="display:inline-block;vertical-align:middle;padding-left:10px">'
                + '<span style="display:block;font-size:15px;font-weight:800;color:#17161C;letter-spacing:-.01em">DE-CHIMEX</span>'
                + '<span style="display:block;font-size:9.5px;font-weight:700;letter-spacing:2.4px;color:#4338CA">PRINT HUB</span></span></div>'
                + '<div style="padding:26px 24px 28px"><h1 style="margin:0 0 12px;font-size:24px;line-height:1.2;font-weight:800;color:#17161C;letter-spacing:-.02em">' + subject.replace(/</g, '&lt;') + '</h1>' + body + '</div>'
                + '<div style="padding:16px 24px 18px;border-top:1px solid #E7E4DC;background:#FCFBF9">'
                + '<p style="margin:0 0 8px;font-size:12.5px;line-height:1.6;color:#64748B">Creativity with Ease. Custom printing, branded merchandise and personalised gifts, ordered online and produced with care.</p>'
                + '<p style="margin:0 0 6px;font-size:12.5px;color:#64748B">Privacy &middot; Terms &middot; Contact</p>'
                + '<p style="margin:0;font-size:12px;color:#64748B">&copy; ' + new Date().getFullYear() + ' DE-CHIMEX PRINT HUB. All rights reserved.</p>'
                + '<p style="margin:10px 0 0;font-size:12px;color:#64748B">You received this email because you are a registered DE-CHIMEX customer. <a href="#" style="color:#4338CA;text-decoration:underline">Unsubscribe</a> from marketing emails.</p>'
                + '</div></div></div></body></html>';
            document.getElementById('previewFrame').srcdoc = doc;
            document.getElementById('previewCard').style.display = '';
        });
    </script>
}
